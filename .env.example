DJANGO_DEBUG=True
DJANGO_SECRET_KEY=solo-desarrollo-reemplazar-antes-de-produccion
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY=False

# PostgreSQL es la base principal. Define una contraseña propia y única.
DJANGO_DATABASE_ENGINE=postgresql
POSTGRES_DB=vitadent
POSTGRES_USER=vitadent
POSTGRES_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_LOCAL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Deja vacía esta variable para usar caché local en memoria
REDIS_URL=
REDIS_PASSWORD=

# Vacía deja activo el flujo guiado de Django
VITADENT_RASA_URL=
# Define el mismo secreto aleatorio en Django y el servidor de acciones de Rasa.
# Protege operaciones de cita y consultas internas de catálogo y disponibilidad.
VITADENT_RASA_TOKEN=
VITADENT_DJANGO_INTERNAL_URL=http://127.0.0.1:8000

# WhatsApp Cloud API de Meta: completa estos valores con el entorno oficial de la clínica
VITADENT_WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
VITADENT_CONVERSATION_RETENTION_DAYS=30
VITADENT_MIN_CANCEL_HOURS=0
